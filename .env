# HuggingFace Cache
HF_HOME=./hf-cache
TRANSFORMERS_CACHE=./hf-cache/transformers
SENTENCE_TRANSFORMERS_HOME=./hf-cache/sentence_transformers

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=google/flan-t5-base
DEVICE=cpu

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=false

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Retrieval Configuration
TOP_K=4
SIMILARITY=cosine
EMBED_BATCH=32

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
